# Copy this file to ".env" and fill in your real values.
# .env is gitignored — it holds secrets, so never commit it.

# ---- 1. BOT TOKEN (from @BotFather) ----
TG_BOT_TOKEN=8877121209:AAEq1mfJe5_NoMUyEW4UpT5NC6DbxK5FIfg

# ---- 2. TELEGRAM API CREDENTIALS (free, from https://my.telegram.org/login -> API development tools) ----
TG_API_ID=1234567
TG_API_HASH=your_api_hash_string

# ---- 3. WHERE DOWNLOADS LAND on THIS machine (edit this!) ----
# Full path to your media/downloads folder. Mounted into the container
# at /downloads. Examples:
#   MEDIA_HOST_DIR=/media/devmon/sda1-usb-Kingston_DataTra
#   MEDIA_HOST_DIR=/home/you/Videos
MEDIA_HOST_DIR=/media/devmon/sda1-usb-Kingston_DataTra

# Maximum number of parallel downloads (0 = unlimited). Default: 2
TG_MAX_PARALLEL=2

# ---- 4. (optional) lock to only YOUR account — get id via @userinfobot ----
# Add allowed Telegram user ids (comma-separated). 0 = anyone private.
TG_ALLOWED_USER_ID=0

# Not needed if you use docker-compose (the compose file sets this)
# TG_OUTPUT_DIR=/downloads